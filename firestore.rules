rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (request.auth.token.admin == true || request.auth.token.email.matches('.*@galaxycorp[.]com$'));
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /newsFacts/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /languageContent/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /system_config/{configId} {
      allow read, write: if isAdmin();
    }

    match /notificationLog/{logId} {
      allow read, write: if false;
    }

    match /pipeline_audit_log/{logId} {
      allow read, write: if isAdmin();
    }
  }
}