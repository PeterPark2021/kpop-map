rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (request.auth.token.admin == true || request.auth.token.email.matches('.*@galaxycorp[.]com$'));
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /newsFacts/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /languageContent/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 만 14세 인증(ageVerified == true)이 완료된 소유자만 사용자 문서 읽기/쓰기 가능
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
                            && request.resource.data.ageVerified == true;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /system_config/{configId} {
      allow read, write: if isAdmin();
    }

    match /notificationLog/{logId} {
      allow read, write: if false;
    }

    match /pipeline_audit_log/{logId} {
      allow read, write: if isAdmin();
    }
  }
}