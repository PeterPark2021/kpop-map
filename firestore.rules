rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 헬퍼: 관리자 권한 검증 (Custom Claim admin: true)
    function isAdmin() {
      return request.auth != null && (request.auth.token.admin == true || request.auth.token.email.matches('.*@galaxycorp[.]com$'));
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /newsFacts/{newsId} {
      allow read: if resource.data.isOfficial == true || resource.data.reviewStatus == 'approved';
      allow write: if isAdmin();
    }

    match /languageContent/{contentId} {
      allow read: if resource.data.reviewStatus == 'approved';
      allow write: if isAdmin();
    }

    match /pipeline_audit_log/{logId} {
      allow read, write: if isAdmin();
    }
  }
}