rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (request.auth.token.admin == true || request.auth.token.email.matches('.*@galaxycorp[.]com$'));
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /newsFacts/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /languageContent/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 일반 회원 프로필: 오직 본인(request.auth.uid == uid)만 읽기/쓰기 허용
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 내부 알림 로그: 클라이언트 직접 접근 완전 차단 (Cloud Functions 전용)
    match /notificationLog/{logId} {
      allow read, write: if false;
    }

    match /pipeline_audit_log/{logId} {
      allow read, write: if isAdmin();
    }
  }
}