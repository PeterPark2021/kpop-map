rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    match /newsFacts/{newsId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /languageContent/{contentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}