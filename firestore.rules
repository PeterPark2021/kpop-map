rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    match /newsFacts/{newsId} {
      allow read: if resource.data.isOfficial == true || resource.data.reviewStatus == 'approved';
      allow write: if request.auth != null;
    }

    // languageContent: 오직 승인된 항목만 공개 API 노출 (거버넌스 규칙)
    match /languageContent/{contentId} {
      allow read: if resource.data.reviewStatus == 'approved' || request.auth != null;
      allow write: if request.auth != null;
    }
  }
}